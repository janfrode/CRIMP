    {
      "name": "McLeod",
      "source": "mcleod.txt. Before: full body warm-up; finger prep 2-4 min (tendon glides, no hangs); shoulder prep 2-4 min (scap retractions, band work). Sets 1-2 warm-up and 6-7 cool-down on a jug, sets 3-5 on a 20mm edge. Pull-up sets: goal 5 pull ups per 10 s hang.",
      "programs": [
        {
          "name": "McLeod",
          "description": "Warm up first: full body, finger prep 2-4 min (tendon glides, no hangs), shoulder prep 2-4 min (scap retractions, band work). Sets 1-2 are warm-up on a jug: hangs, then pull-up hangs (goal 5 pull ups each). Sets 3-5 are work on a 20 mm edge: open crimp, half crimp, three finger open drag. Sets 6-7 are cool-down on a jug.",
          "steps": [
            { "repeat": 7, "name": "Rep",
              "do": [ { "type": "hang", "sec": 10, "label": "JUG HANG" } ],
              "between": [ { "type": "rest", "sec": 30 } ] },
            { "type": "rest", "sec": 60, "label": "SET REST" },
            { "repeat": 2, "name": "Rep",
              "do": [ { "type": "hang", "sec": 10, "label": "PULL UPS" } ],
              "between": [ { "type": "rest", "sec": 60 } ] },
            { "type": "rest", "sec": 120, "label": "SET REST" },
            { "repeat": 3, "name": "Rep",
              "do": [ { "type": "hang", "sec": 10, "label": "OPEN CRIMP" } ],
              "between": [ { "type": "rest", "sec": 60 } ] },
            { "type": "rest", "sec": 60, "label": "SET REST" },
            { "repeat": 3, "name": "Rep",
              "do": [ { "type": "hang", "sec": 10, "label": "HALF CRIMP" } ],
              "between": [ { "type": "rest", "sec": 60 } ] },
            { "type": "rest", "sec": 60, "label": "SET REST" },
            { "repeat": 3, "name": "Rep",
              "do": [ { "type": "hang", "sec": 10, "label": "3F OPEN DRAG" } ],
              "between": [ { "type": "rest", "sec": 60 } ] },
            { "type": "rest", "sec": 120, "label": "SET REST" },
            { "repeat": 2, "name": "Rep",
              "do": [ { "type": "hang", "sec": 10, "label": "PULL UPS" } ],
              "between": [ { "type": "rest", "sec": 60 } ] },
            { "type": "rest", "sec": 60, "label": "SET REST" },
            { "repeat": 2, "name": "Rep",
              "do": [ { "type": "hang", "sec": 10, "label": "JUG HANG" } ],
              "between": [ { "type": "rest", "sec": 60 } ] }
